# Postgres (local via docker-compose)
DATABASE_URL=postgresql://accounting:accounting@localhost:5432/accounting

# API
API_PORT=4000
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=180
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Web (Vite)
VITE_API_URL=http://localhost:4000


# 32-byte hex key for sensitive-field encryption (vendor tax IDs, employee SSNs).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# Path where uploaded files (receipts, shipping labels, compliance docs) are stored.
# Dev default: ./.local-data/files. Prod (Railway): /data/files via volume mount.
FILE_STORAGE_DIR=./.local-data/files