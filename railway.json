{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "watchPatterns": [
      "/apps/api/**",
      "/packages/shared/**",
      "/db/**",
      "/bin/**",
      "/package.json",
      "/package-lock.json",
      "/railway.json",
      "/nixpacks.toml"
    ]
  },
  "deploy": {
    "startCommand": "npm run migrate:prod && npm run start:api",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
